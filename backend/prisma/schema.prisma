// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String
  profile  Profile @default(USER)

  pedidos Pedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Profile {
  ADMIN
  USER
}

model Sala {
  id         Int @id @default(autoincrement())
  numero     Int
  linhas     Int
  colunas    Int
  capacidade Int

  poltronas Poltrona[]
  sessoes   Sessao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([numero])
}

model Filme {
  id                 Int         @id @default(autoincrement())
  titulo             String
  sinopse            String
  classificacao      String
  duracao            Int
  elenco             String
  genero             GeneroFilme
  cartazUrl          String?
  dataInicioExibicao DateTime
  dataFinalExibicao  DateTime

  sessoes Sessao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GeneroFilme {
  ACAO
  COMEDIA
  DRAMA
  TERROR
  ANIMACAO
  SUSPENSE
  ROMANCE
  DOCUMENTARIO
}

model Sessao {
  id              Int      @id @default(autoincrement())
  horarioExibicao DateTime
  valorInteira    Decimal  @default(0)
  valorMeia       Decimal  @default(0)

  filmeId Int
  filme   Filme @relation(fields: [filmeId], references: [id])

  salaId Int
  sala   Sala @relation(fields: [salaId], references: [id])

  ingressos Ingresso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Poltrona {
  id     Int    @id @default(autoincrement())
  codigo String

  salaId Int
  sala   Sala @relation(fields: [salaId], references: [id])

  ingressos Ingresso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salaId, codigo])
}

model Ingresso {
  id    Int          @id @default(autoincrement())
  tipo  TipoIngresso
  valor Decimal

  sessaoId Int
  sessao   Sessao @relation(fields: [sessaoId], references: [id])

  poltronaId Int
  poltrona   Poltrona @relation(fields: [poltronaId], references: [id])

  pedidoId Int
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pedido {
  id              Int               @id @default(autoincrement())
  status          StatusPedido      @default(ABERTO)
  valorTotal      Decimal           @default(0)
  metodoPagamento MetodoPagamento?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  ingressos Ingresso[]
  produtos  PedidoProduto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Produto {
  id            Int         @id @default(autoincrement())
  nome          String
  descricao     String
  tipo          TipoProduto
  imagemUrl     String?
  valorUnitario Decimal
  ativo         Boolean     @default(true)

  pedidos PedidoProduto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PedidoProduto {
  id            Int     @id @default(autoincrement())
  quantidade    Int
  valorUnitario Decimal
  subtotal      Decimal

  pedidoId Int
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TipoIngresso {
  INTEIRA
  MEIA
}

enum StatusPedido {
  ABERTO
  PAGO
  CANCELADO
}

enum MetodoPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
}

enum TipoProduto {
  ALIMENTO
  BEBIDA
  COMBO
}
